# Required: use a strong, unique value for each field before first startup.
HOYOZERO_DB_ROOT_PASSWORD=replace-with-a-strong-database-password
HOYOZERO_RUNNER_TOKEN=replace-with-a-random-runner-token
HOYOZERO_INITIAL_ADMIN_USERNAME=admin
HOYOZERO_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional Dify integration
DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_APP_ID=

# Optional container registry credentials
REGISTRY_USERNAME=
REGISTRY_TOKEN=
